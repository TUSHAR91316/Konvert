# ==========================================
# Konvert Backend Configuration
# ==========================================
# Copy this file to '.env' and enter your details below.

# 1. Ngrok Auth Token (Required for public URL)
# Get this for free at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_auth_token_here

# 2. Ngrok Static Domain (Optional but recommended)
# Get a free static domain at https://dashboard.ngrok.com/cloud-edge/domains
# E.g. your-name.ngrok-free.app
NGROK_DOMAIN=your_static_domain_here.ngrok-free.app
